{% extends 'partials/base.html.twig' %}

{% block content %}

<main>
    <header>
        <div id="timer">
            <h2 id="t1me-clock">
                <span>9</span><span>.</span><span>3</span><span>5</span><span>2</span><span>.</span><span>1</span><span>0</span><span>0</span>
            </h2>
            <h2>
                <span>seconds</span>
                <span>since</span>
                <span>1st</span>
                <span>T1MESCULPTURE</span>
            </h2>
        </div>
        <h1 style="align-self: center; text-align: center">T1MESCULPTURES</h1>
        <h2 style="align-self: end; text-align: right">etlaM</h2>
    </header>
    {# Loop through all child pages (projects) #}
    {% for p in page.collection %}
        {% if p.header.show_on_home != false %}
            
            <a href="{{ p.url }}" class="project-card">
            
                <p>{{ p.header.number }}</p>
                <p>{{ p.title }}</p>
                {# 1. The Static Image #}
                {% if p.header.thumb_image %}
                    {# Get the first item from the list #}
                    {% set cover = p.header.thumb_image|first %}
                    {# Use cover.name to find the file #}
                    <img src="{{ p.media[cover.name].url }}" class="static-thumb" alt="{{ p.title }}">
                {% endif %}

                {# 2. The Hover Video #}
                {% if p.header.hover_video %}
                    {# Get the first item from the list #}
                    {% set video_file = p.header.hover_video|first %}
                    
                    <video loop muted playsinline class="hover-media" poster="">
                        {# Use video_file.name #}
                        <source src="{{ p.media[video_file.name].url }}" type="video/webm">
                    </video>
                {% endif %}
            </a>
        {% endif %}
    {% endfor %}
</main>
<script>
    // Unix Timestamp: Oct 27, 2025 @ 3:09pm (UTC) - 1st T1MESCULPTURE
    const startTimestamp = 1761577740;
    
    const displayElement = document.getElementById('t1me-clock');

    function updateCounter() {
        // Get current Unix time in seconds (divide by 1000 and floor)
        const currentTimestamp = Math.floor(Date.now() / 1000);
        
        // Calculate seconds elapsed
        const secondsElapsed = currentTimestamp - startTimestamp;

        // Format numbers with commas for readability (e.g., 1,234,567)
        const formattedSeconds = secondsElapsed.toLocaleString();

        // Generate HTML with spans and inline CSS variables
        let html = '';
        [...formattedSeconds].forEach((char, index) => {
            // We set --i directly here so the animation knows the order immediately
            html += `<span style="--i:${index}">${char}</span>`;
        });

        // Inject into the DOM
        displayElement.innerHTML = html;
    }

    // Update every 1000ms (1 second)
    setInterval(updateCounter, 1000);

    // Initialize immediately
    updateCounter();


    // Text Wipe Setup -> Delay Elements
    const rows = document.querySelectorAll('#timer h2');

    rows.forEach(row => {
    const spans = row.querySelectorAll('span');
        spans.forEach((span, i) => {
            span.style.setProperty('--i', i);
        });
    });
</script>
{% endblock %}